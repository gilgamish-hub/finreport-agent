# App default: Gemini (free key: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Evaluation: Groq free tier (free key: https://console.groq.com/keys)
GROQ_API_KEY=
FINAGENT_LLM=groq:openai/gpt-oss-120b
FINAGENT_FAST_LLM=groq:openai/gpt-oss-20b
FINAGENT_JUDGE_LLM=groq:qwen/qwen3.8-27b

# Other options ("<provider>:<model>", anything langchain's init_chat_model supports)
